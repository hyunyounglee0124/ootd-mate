# ─────────────────────────────────────────────────────────────
# 환경 변수 예시 파일 (GitHub에 올라가는 파일)
# ⚠️ 이 파일에는 진짜 API 키를 절대 쓰지 않는다.
# 로컬에서는 이 파일을 복사해 .env 를 만들고, .env 에만 키를 넣는다.
# (.env 는 .gitignore 에 들어 있어서 GitHub에 올라가지 않는다)
# ─────────────────────────────────────────────────────────────

# 어떤 AI 방식을 쓸지: anthropic(Claude, 기본) 또는 openai
AI_PROVIDER=anthropic

# ----- Claude (코디세이 "Anthropic 호환 방식" 키) -----
# 코디세이 API 콘솔 → 키 발급 → 호환 방식 "Anthropic" 으로 발급한 키
ANTHROPIC_API_KEY=
# 코디세이 서버 주소 (끝에 /v1 을 붙이지 않는다)
ANTHROPIC_BASE_URL=https://copa.codyssey.kr
# 모델: claude-haiku-4 (빠르고 저렴) 또는 claude-sonnet-4 (더 정교함)
ANTHROPIC_MODEL=claude-haiku-4

# ----- (선택) OpenAI 방식으로 바꿔 쓸 때만 -----
# AI_PROVIDER=openai 로 바꾸고, 코디세이에서 "OpenAI 호환 방식" 키를 발급해 넣는다
OPENAI_API_KEY=
OPENAI_BASE_URL=https://copa.codyssey.kr/v1
OPENAI_MODEL=gpt-5-mini

# ----- 로컬 테스트용 (배포 환경에는 넣지 않는다) -----
# 1 이면 AI 대신 가짜 답. 키가 비어 있으면 자동으로 가짜 답 모드가 된다.
MOCK_AI=0
# 가짜 답을 N초 늦게 → "응답이 늦어지고 있어요" 안내 확인용
MOCK_DELAY=0
# 500 같은 숫자 → 그 오류를 일부러 내서 오류 안내 확인용
MOCK_FAIL=
