{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "옷장메이트 실행",
      "type": "shell",
      "command": "python3 dev_server.py",
      "windows": { "command": "python dev_server.py" },
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "패키지 설치 (진짜 AI 쓸 때 1번만)",
      "type": "shell",
      "command": "python3 -m pip install -r requirements.txt",
      "windows": { "command": "python -m pip install -r requirements.txt" },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "백엔드 테스트",
      "type": "shell",
      "command": "python3 -m unittest discover tests -v",
      "windows": { "command": "python -m unittest discover tests -v" },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
